{
  "name": "cpu-llm",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/src/index.js",
    "dev:server": "AGENT_TOKEN=${AGENT_TOKEN:-dev-token} node --watch server/src/index.js",
    "dev:frontend": "npm run dev -w frontend",
    "test": "npm test --workspaces",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "marked": "^14.1.4"
  }
}
